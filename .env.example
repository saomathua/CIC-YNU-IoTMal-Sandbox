# -------------------------------------------------------
# IoT-CIC-Sandbox — root environment file
# Copy this file to .env (never commit .env) and replace the
# placeholder values. This file is read by the top-level
# docker-compose.yml for variable substitution only; values are
# passed to containers at runtime, not copied into images.
# -------------------------------------------------------

# --- MongoDB credentials (shared by manager and mongo service) ---
# Placeholders only — choose your own values. Required: compose refuses
# to start if these are empty. MongoDB only applies them when
# ./data/mongo is first initialised.
MONGO_USERNAME=sandbox_admin
MONGO_PASSWORD=CHANGE_ME

# --- Manager ---

# Host address the manager API is published on. Keep 127.0.0.1 and
# use an SSH tunnel (see docs/deployment.md). 0.0.0.0 exposes it on
# every host interface — the API has no authentication.
MANAGER_BIND_ADDR=127.0.0.1

# Host port the manager API is exposed on
MANAGER_PORT=8011

# Host directory with samples, mounted read-only at /malware
MALWARE_DIR=./malware

# --- Workers ---

# Seconds to let the malware run inside the VM before stopping monitors
ANALYSIS_DURATION=30

# Seconds to wait after stopping monitors before shutting the VM down
# (allows the guest OS to flush captured files to the virtual disk)
POST_ANALYSIS_WAIT=30

# VM internet access. Default here: false (requested isolation).
# NOTE: enforcement by sandbox-worker/run.sh has not been verified yet;
# do not rely on it before the isolation test in docs/deployment.md.
ALLOW_VM_INTERNET=false
