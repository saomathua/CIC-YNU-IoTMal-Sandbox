+# never read as 0.
+capture_stats() {
+    awk '/^[0-9]+ packets captured$/ {c=$1; nc++}
+         /^[0-9]+ packets received by filter$/ {r=$1; nr++}
+         /^[0-9]+ packets dropped by kernel$/ {d=$1; nd++}
+         END { if (nc != 1 || nr != 1 || nd != 1) exit 1; print c, r, d }' "$1"
+}
