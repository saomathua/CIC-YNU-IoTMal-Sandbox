+    ("A18", AC, [('    if tb != ta:', '    if False:')], "N4 new entry on tap0 -> problem"),
+    ("A19", AC, [('        if dev != "tap0" and v["lladdr"] == guest:', '        if False:')],
+     "N9 a NEW, unwatched eth0 entry carrying the guest MAC -> problem"),
+    ("A20", AC, [('                and before[(dst, dev)]["lladdr"] != v["lladdr"]:', '                and False:')],
+     "N7 watched IP changes its MAC on eth0 -> problem"),
+    ("A21", AC, [('        raise NeighReadError("not a JSON list")', '        rows = []')],
+     "N8 unreadable neighbour output -> NeighReadError (never 'unchanged')"),
+    # execution
+    ("A22", AC, [('            rec["stopped"] = NOT_RUN', '            pass')],
