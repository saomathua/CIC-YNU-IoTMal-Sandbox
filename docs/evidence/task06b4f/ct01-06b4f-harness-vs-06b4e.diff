+            echo "net.ipv4.conf.$dev.$a=$(sysctl -n "net.ipv4.conf.$dev.$a" 2>&1)"; done; done
+    } > "$d/sysctl.txt"
+    ss -ltnH | awk '{print $4}' | sort > "$d/listen-tcp.txt"
