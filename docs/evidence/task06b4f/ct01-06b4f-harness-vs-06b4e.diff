+    pgrep -a qemu-system > "$d/qemu.txt" 2>&1 || echo "no qemu-system" > "$d/qemu.txt"
+    pgrep -a 'tshark|dumpcap|tcpdump' > "$d/capture-procs.txt" 2>&1 || echo "no capture processes" > "$d/capture-procs.txt"
+}
