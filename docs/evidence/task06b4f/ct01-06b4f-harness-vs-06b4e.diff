+            docker logs --timestamps "$id" > "$OUT/final-logs-${id:0:12}.txt" 2>&1 || true
+            docker rm -f "$id" >/dev/null 2>&1 || true
+        fi
+    done
+    manager_restore >> "$OUT/manager-state.txt" 2>&1 || true   # no-op if teardown already restored it
+}
+trap cleanup EXIT
