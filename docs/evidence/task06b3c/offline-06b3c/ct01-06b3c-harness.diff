+#!/bin/bash
+# 06B-3C — offline self-test of the harness helpers. No root, no Docker, no QEMU, no network traffic.
+#
+#   bash selftest.sh [outdir]
+#
+#  A. sigscan.sh against generated fixtures: exact counts on positive/negative pcaps, read errors on
+#     truncated and empty files, and every real probe URL of probe_matrix.py's plan must match.
+#  B. capture watcher (harness_lib.sh): stays quiet while the watched processes live, writes the
+#     capture-dead marker when one exits.
+#  B2. probe_matrix.py captures_alive(): stops on a dead tap0 tshark or a non-empty host marker.
+#  C. manager handling (harness_lib.sh) with a fake `docker`/compose: running stays running and is
+#     never restarted; exited is started and stopped again; a changed state or container is FAIL.
+# Exit 0 only if every check passes. Deletes nothing (it runs as root inside run-06b3b.sh).
+set -uo pipefail
+H=$(cd "$(dirname "$0")" && pwd)
+OUTD=${1:-$(mktemp -d)}
+mkdir -p "$OUTD"
+FAILS=0
+ok()  { echo "[PASS] $*"; }
+bad() { echo "[FAIL] $*"; FAILS=$((FAILS + 1)); }
+t()   { local m=$1; shift; if "$@"; then ok "$m"; else bad "$m"; fi; }
+
+echo "== A. signature scanner"
+python3 "$H/make_fixtures.py" "$OUTD/fx" || { echo "fixture build failed"; exit 1; }
+sha256sum "$OUTD"/fx/*.pcap
+for f in positive.pcap negative.pcap; do
+    got=$(bash "$H/sigscan.sh" "$OUTD/fx/$f"); rc=$?
+    echo "-- $f (rc=$rc)"; echo "$got"
+    t "$f: sigscan exit 0" test $rc -eq 0
+    want=$(python3 -c "import json,sys; d=json.load(open(sys.argv[1]))[sys.argv[2]]; print('\n'.join(f'{k}={v}' for k,v in d.items()))" \
+        "$OUTD/fx/expected.json" "$f")
+    t "$f: counts equal expected.json" test "$got" = "$want"
+done
+for f in truncated.pcap empty.pcap; do
+    bash "$H/sigscan.sh" "$OUTD/fx/$f" > /dev/null 2> "$OUTD/fx/$f.err"; rc=$?
+    echo "-- $f: rc=$rc $(head -c 200 "$OUTD/fx/$f.err")"
+    t "$f: read error reported (exit 2), never counted as 0 packets" test $rc -eq 2
+done
+bash "$H/sigscan.sh" "$OUTD/fx/missing.pcap" > /dev/null 2>&1
+t "missing file: read error reported (exit 2)" test $? -eq 2
+# Every probe URL that probe_matrix.py can build must match the scanner's URL regex.
+names=$(python3 - "$H/probe_matrix.py" <<'EOF'
+import re, sys
+src = open(sys.argv[1]).read()
+fixed = re.findall(r'plan(?:\.append\(\(| = \[\()"([a-z0-9-]+)"', src)
+assert 'f"ssh-host-{ip}"' in src
+print("\n".join(fixed + ["ssh-host-192.168.60.1", "ssh-host-192.168.177.128", "ssh-host-172.18.0.1"]))
+EOF
+)
+echo "probe names from probe_matrix.py: $(echo $names)"
+t "probe_matrix.py plan has 7 fixed names + 3 ssh-host" test "$(echo "$names" | wc -l)" -eq 10
+URL_RE=$(bash -c 'source <(sed -n "/^NAMES=/p;/^URL_RE=/p" "$1"); echo "$URL_RE"' _ "$H/sigscan.sh")
+miss=0
+for n in $names; do
+    printf 'GET /ct01-06b3b-%s HTTP/1.1\n' "$n" | grep -qE "$URL_RE" || { echo "no match: $n"; miss=1; }
+done
+t "every real probe URL matches the scanner regex" test $miss -eq 0
+t "06B-3B regex /ct01-06b3b-[0-9] matched none of them (the defect being fixed)" \
+    bash -c "! printf '%s\n' $(echo $names | sed 's|[^ ]*|/ct01-06b3b-&|g') | grep -qE '/ct01-06b3b-[0-9]'"
+
+echo "== B. capture watcher"
+source "$H/harness_lib.sh"
+M="$(mktemp -d "$OUTD/watch.XXXXXX")/capture-dead.txt"   # fresh dir: marker cannot pre-exist
+sleep 30 & P1=$!
+sleep 30 & P2=$!
+start_capture_watch "$M" 0.2 "p1:$P1" "p2:$P2"
+sleep 1
+t "watcher quiet while captures run" test ! -e "$M"
+kill "$P2"   # not reaped on purpose: a zombie must count as dead
+for i in $(seq 1 20); do [ -s "$M" ] && break; sleep 0.2; done
+echo "marker: $(cat "$M" 2>/dev/null)"
+t "watcher writes marker naming the dead capture" grep -q "p2 pid $P2 exited" "$M"
+stop_capture_watch
+t "watcher stopped" bash -c "! kill -0 $WATCH_PID 2>/dev/null"
+kill "$P1"; wait "$P1" 2>/dev/null
+
+echo "== B2. probe_matrix.py captures_alive (extracted with ast; a sleep process stands in for tshark)"
+python3 - "$H/probe_matrix.py" "$OUTD/pm-marker.txt" <<'EOF'
+import ast, subprocess, sys, time
+src = open(sys.argv[1]).read()
+tree = ast.parse(src)
+keep = [n for n in tree.body if isinstance(n, (ast.ClassDef, ast.FunctionDef)) and n.name in ("CaptureLost", "captures_alive")]
+assert len(keep) == 2, "captures_alive / CaptureLost not found"
+ns = {"open": open, "CAPTURE_DEAD": sys.argv[2]}
+exec(compile(ast.Module(body=keep, type_ignores=[]), "probe_matrix.py", "exec"), ns)
+fails = 0
+def expect(msg, fn, lost):
+    global fails
+    try:
+        fn(); got = False
+    except ns["CaptureLost"] as e:
+        got = True; msg += f" ({e})"
+    ok = got == lost
+    fails += not ok
+    print(("[PASS] " if ok else "[FAIL] ") + msg)
+p = subprocess.Popen(["sleep", "30"])
+expect("tshark alive, no marker -> continue", lambda: ns["captures_alive"](p, "t1"), False)
+open(sys.argv[2], "w").write("12:00:00 capture ens33 pid 1 exited during the test\n")
+expect("host marker present -> CaptureLost", lambda: ns["captures_alive"](p, "t2"), True)
+open(sys.argv[2], "w").close()
+expect("empty marker file -> continue", lambda: ns["captures_alive"](p, "t3"), False)
+p.kill(); p.wait()
+expect("tshark exited -> CaptureLost", lambda: ns["captures_alive"](p, "t4"), True)
+expect("tshark never started -> CaptureLost", lambda: ns["captures_alive"](None, "t5"), True)
+sys.exit(1 if fails else 0)
+EOF
+t "probe_matrix.py captures_alive behaves as specified" test $? -eq 0
+
+echo "== C. manager handling (fake docker)"
+docker() {   # fake: inspect -f <fmt> <name> | compose ... up/stop
+    case "$1" in
+    inspect)
+        case "$3" in
+        *State.Status*) cat "$FAKE_STATE/status" ;;
+        *State.StartedAt*) cat "$FAKE_STATE/started" ;;
+        *.Id*) cat "$FAKE_STATE/id" ;;
+        esac ;;
+    compose)
+        case " $* " in
+        *" up "*) echo running > "$FAKE_STATE/status"; date +%s%N > "$FAKE_STATE/started"; echo up >> "$FAKE_STATE/calls" ;;
+        *" stop "*) echo exited > "$FAKE_STATE/status"; echo stop >> "$FAKE_STATE/calls" ;;
+        esac ;;
+    esac
+}
+COMPOSE=(docker compose -f fake.yml); MANAGER=fake-manager
+scenario() {  # initial-status -> runs prepare/restore, prints result
+    FAKE_STATE=$(mktemp -d "$OUTD/fake-manager.XXXXXX")   # fresh state per scenario, nothing removed
+    MANAGER_STARTED=0; MANAGER_RESTORED=0; MANAGER_RESTORE_RC=0; unset MANAGER_STATE_BEFORE   # fresh run
+    echo "$1" > "$FAKE_STATE/status"; echo T0 > "$FAKE_STATE/started"; echo cid1 > "$FAKE_STATE/id"; : > "$FAKE_STATE/calls"
+    manager_prepare > /dev/null
+    [ "$(cat "$FAKE_STATE/status")" = running ] || return 1
+    [ -n "${2:-}" ] && eval "$2"     # optional tampering during the test
+    manager_restore > /dev/null
+}
+scenario running; rc=$?
