+#!/bin/bash
+# 06B-3C — check that selftest.sh detects broken helpers. No root, no Docker, no network, deletes nothing.
+#
+#   bash mutation_test.sh
+#
+# Each mutation is applied to a COPY of the harness in a new mktemp directory; selftest.sh must then
+# fail (rc != 0). The original files are only read. Exit 0 only if every mutation is detected.
+set -uo pipefail
+H=$(cd "$(dirname "$0")" && pwd)
+W=$(mktemp -d "${TMPDIR:-/tmp}/ct01-06b3c-mut.XXXXXX")
+echo "work dir (left in place for inspection): $W"
+MISSED=0
+mut() {
+    local name=$1 file=$2 old=$3 new=$4 d out rc
+    d=$(mktemp -d "$W/$name.XXXXXX")
+    cp "$H"/*.sh "$H"/*.py "$d/"
+    python3 - "$d/$file" "$old" "$new" <<'EOF' || { echo "$name: MUTATION NOT APPLIED"; MISSED=$((MISSED + 1)); return; }
+import sys
+p, old, new = sys.argv[1:4]
+s = open(p).read()
+assert s.count(old) == 1, "pattern not found exactly once"
+open(p, "w").write(s.replace(old, new))
+EOF
+    out=$(bash "$d/selftest.sh" "$d/out" 2>&1); rc=$?
+    if [ $rc -ne 0 ]; then
+        echo "[DETECTED] $name (selftest rc=$rc): $(echo "$out" | grep '^\[FAIL\]' | head -2 | tr '\n' ' ')"
+    else
+        echo "[MISSED]   $name"; MISSED=$((MISSED + 1))
+    fi
+}
+mut M1-06b3b-url-regex sigscan.sh \
+    'URL_RE="/ct01-06b3b-($NAMES)([^A-Za-z0-9.-]|\$)"' 'URL_RE="/ct01-06b3b-[0-9]"'
+mut M2-payload-scan-counts-lines sigscan.sh \
+    'P=$(printf '"'"'%s\n'"'"' "$A" | per_packet)' 'P=$A'
+mut M3-read-error-ignored sigscan.sh \
+    'if [ $rc -ne 0 ] || grep -qv' 'if false && grep -qv'
+mut M4-empty-file-not-checked sigscan.sh \
+    '[ -s "$F" ] || { echo "READ ERROR: $F is empty or missing" >&2; exit 2; }' ':'
+mut M5-zombie-counts-as-alive harness_lib.sh \
+    '[ -n "$s" ] && [ "${s:0:1}" != Z ]' 'kill -0 "$1" 2>/dev/null'
+mut M6-running-manager-restarted harness_lib.sh \
+    'echo "manager already running: used as is, will be left running"' \
+    '"${COMPOSE[@]}" up -d --no-deps --no-build sandbox-manager; MANAGER_STARTED=1'
+mut M7-manager-always-stopped harness_lib.sh \
+    'if [ "$MANAGER_STARTED" = 1 ]; then' 'if true; then'
+mut M8-restart-not-detected harness_lib.sh \
+    '[ "$at" != "$MANAGER_STARTED_AT_BEFORE" ]' 'false'
+mut M9-host-marker-ignored probe_matrix.py \
+    '    if dead:' '    if False:'
+mut M10-tshark-exit-ignored probe_matrix.py \
+    'if tshark is None or tshark.poll() is not None:' 'if tshark is None:'
+echo
+[ $MISSED -eq 0 ] && { echo "MUTATION TEST: all mutations detected"; exit 0; }
+echo "MUTATION TEST: $MISSED mutation(s) NOT detected"; exit 1
