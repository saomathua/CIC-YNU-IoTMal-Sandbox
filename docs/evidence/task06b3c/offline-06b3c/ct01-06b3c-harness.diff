+# 06B-3C — helpers sourced by run-06b3b.sh and exercised offline by selftest.sh.
+
+# ---------------------------------------------------------------- capture watcher
+# alive <pid>: process exists and is not a zombie (an exited child that was not reaped yet).
+alive() {
+    local s
+    s=$(ps -o stat= -p "$1" 2>/dev/null) || return 1
+    [ -n "$s" ] && [ "${s:0:1}" != Z ]
+}
+
+# start_capture_watch <marker> <interval-s> <name:pid>...
+# Background loop: the first watched process that is gone is written to <marker> and the loop ends.
+# probe_matrix.py checks the marker (mounted as /hostcap/capture-dead.txt) before and after every
+# probe and stops; run-06b3b.sh checks it after every guest and at the end.
+start_capture_watch() {
+    local marker=$1 interval=$2
+    shift 2
+    (
+        trap - EXIT INT TERM
+        while :; do
+            for e in "$@"; do
+                if ! alive "${e##*:}"; then
+                    echo "$(date -u +%H:%M:%S) capture ${e%%:*} pid ${e##*:} exited during the test" >> "$marker"
+                    exit 0
+                fi
+            done
+            sleep "$interval"
+        done
+    ) &
+    WATCH_PID=$!
+}
+
+# Stop the watcher BEFORE stopping the captures on purpose, so a normal stop is not reported.
+stop_capture_watch() {
+    if [ -n "${WATCH_PID:-}" ]; then
+        kill "$WATCH_PID" 2>/dev/null
+        wait "$WATCH_PID" 2>/dev/null
+    fi
+    return 0
+}
+
+# ---------------------------------------------------------------- manager
+# Needs MANAGER (container name) and COMPOSE (array). The manager is only started when it was not
+# running; it is only stopped again when this run started it. A manager that was running is never
+# restarted: its container id and StartedAt must be unchanged at the end.
+MANAGER_STARTED=0
+MANAGER_RESTORED=0
+
+manager_prepare() {
+    MANAGER_STATE_BEFORE=$(docker inspect -f '{{.State.Status}}' "$MANAGER") || return 2
+    MANAGER_ID_BEFORE=$(docker inspect -f '{{.Id}}' "$MANAGER") || return 2
+    MANAGER_STARTED_AT_BEFORE=$(docker inspect -f '{{.State.StartedAt}}' "$MANAGER") || return 2
+    echo "manager before: state=$MANAGER_STATE_BEFORE id=${MANAGER_ID_BEFORE:0:12} startedAt=$MANAGER_STARTED_AT_BEFORE"
+    case "$MANAGER_STATE_BEFORE" in
+    running)
+        echo "manager already running: used as is, will be left running"
+        ;;
+    exited | created)
+        "${COMPOSE[@]}" up -d --no-deps --no-build sandbox-manager 2>&1 | tail -3
+        MANAGER_STARTED=1
+        echo "manager started by this run: will be stopped again"
+        ;;
+    *)
+        echo "manager in state '$MANAGER_STATE_BEFORE': not touched"
+        return 2
+        ;;
+    esac
+}
+
+# Returns 0 only if state and container are as before (and, if it was running, not restarted).
+manager_restore() {
+    [ "$MANAGER_RESTORED" = 1 ] && return "${MANAGER_RESTORE_RC:-0}"
+    MANAGER_RESTORED=1
+    [ -n "${MANAGER_STATE_BEFORE:-}" ] || { MANAGER_RESTORE_RC=0; return 0; }   # prepare never ran
+    if [ "$MANAGER_STARTED" = 1 ]; then
+        "${COMPOSE[@]}" stop sandbox-manager 2>&1 | tail -2
+    fi
+    local st id at rc=0
+    st=$(docker inspect -f '{{.State.Status}}' "$MANAGER")
+    id=$(docker inspect -f '{{.Id}}' "$MANAGER")
+    at=$(docker inspect -f '{{.State.StartedAt}}' "$MANAGER")
+    echo "manager after: state=$st id=${id:0:12} startedAt=$at (before: $MANAGER_STATE_BEFORE ${MANAGER_ID_BEFORE:0:12} $MANAGER_STARTED_AT_BEFORE; started by this run: $MANAGER_STARTED)"
+    [ "$st" = "$MANAGER_STATE_BEFORE" ] || { echo "manager state differs"; rc=1; }
+    [ "$id" = "$MANAGER_ID_BEFORE" ] || { echo "manager container differs"; rc=1; }
+    if [ "$MANAGER_STATE_BEFORE" = running ] && [ "$at" != "$MANAGER_STARTED_AT_BEFORE" ]; then
+        echo "manager was restarted during the test"; rc=1
+    fi
+    MANAGER_RESTORE_RC=$rc
+    return $rc
+}
