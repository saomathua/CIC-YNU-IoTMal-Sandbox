+                    return pick("manager", (0, b'exited\tid1\t0\t2026-10-08T08:42:17Z\t{"cic-ynu-iotmal-sandbox_sandboxnet":'
+                                           b'{"IPAddress":"","MacAddress":""}}\n', b"", None))
